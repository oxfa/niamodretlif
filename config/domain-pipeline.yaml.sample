version: 2

# Defaults inherited by every source unless a source overrides them.
# One workflow owns one config file. A config file may still contain multiple
# sources, but emitted artifacts are grouped by the config filename instead of
# by each source id.
#
# Optional manual filter files:
# - input/manual_filter_pass/<config-stem>.txt
# - input/manual_filter_out/<config-stem>.txt
# - input/manual_add/<config-stem>.txt
# manual_filter_pass and manual_add entries still require DNS delegation on the
# registrable domain. If delegation is actionable, they skip host-resolution
# and geo and emit filtered output. manual_add takes precedence over matching
# source entries for the same host. If delegation is not actionable, they route
# to unactionable or review using the normal delegation result. Unmatched
# manual_add entries require all enabled sources to share delegation/output
# behavior. Unmatched manual_filter_pass entries route to review without DNS
# lookup because they are operator reconciliation rows. manual_filter_out is
# exact-host-only, takes precedence over matching source entries, bypasses
# DNS/geo entirely, and emits one review row per host. Public suffix inputs are
# prepare-owned review/audit rows because there is no registrable domain to
# query.
#
# Runtime rows use three terminal routes:
# - filtered: positive output rows.
# - review: uncertain or operator-attention rows.
# - unactionable: rows whose registrable domain currently has no usable DNS
#   delegation by NS lookup.
# Duplicate host collapse is keyed by final host and compares dns.delegation,
# dns.host_resolution, geo, and output behavior across enabled sources. For
# manual_add-matched hosts, only delegation/output behavior must match because
# manual_add bypasses host-resolution and geo after delegation passes.
defaults:
  fetch:
    # Network timeout, in seconds, for retrieving source content before the
    # pipeline gives up on the fetch step.
    request_timeout: 30.0

  dns:
    # Resolver pool settings for both DNS stages.
    # Entries must be literal IPv4/IPv6 resolver addresses or the literal
    # "system_resolver" to include the platform resolver. Leave empty to use
    # only the platform resolver unless ECS forces a verified public resolver.
    # ECS-enabled public pools should use resolvers that preserve ECS behavior,
    # such as Google Public DNS (8.8.8.8, 8.8.4.4) and Quad9 ECS
    # (9.9.9.11, 149.112.112.11). Cloudflare 1.1.1.1 and Cisco Umbrella are
    # not default ECS targets here because their public ECS behavior differs.
    nameservers: []
    # Per-query DNS timeout, in seconds.
    timeout: 5.0
    # Optional EDNS Client Subnet (ECS) settings.
    # Set enabled=true and provide a CIDR subnet when querying a resolver that
    # accepts client-supplied ECS data.
    ecs:
      enabled: false
      # Example: 203.0.113.0/24 or 2001:db8::/48
      subnet: ""
      # Scope to advertise in the ECS option. Leave at 0 unless you have a
      # specific resolver-side requirement.
      scope_prefix_length: 0
    # Worker-local DNS safety limits. These defaults are intentionally below
    # documented public provider limits where a numeric public limit exists
    # because GitHub Actions worker_count can multiply aggregate traffic and
    # standard hosted runners do not guarantee a stable dedicated egress IP.
    # Official data inspected on 2026-05-01:
    # Azure platform resolver: 1000 QPS and 200 pending queries per VM.
    # Google Public DNS: rate-increase guidance starts above 1500 QPS per
    # client IPv4 address or IPv6 /64. Quad9 asks organizations to contact
    # support above 500 QPS from one egress IP. Cloudflare publishes no numeric
    # public QPS limit and warns high-rate/proxied/high-SERVFAIL traffic may be
    # rate limited. Cisco Umbrella/OpenDNS documents 5000 DNS queries per
    # Covered User per day as a monthly DNS Security average, not a public
    # per-client QPS ceiling. Cloudflare/OpenDNS values below are conservative
    # project caps, not official numeric QPS limits.
    query_rate_limit:
      enabled: true
      providers:
        system_resolver:
          qps_per_worker: 50.0
          burst: 50
          max_pending: 100
        google_public_dns:
          qps_per_worker: 50.0
          burst: 50
          max_pending: 100
        quad9_ecs:
          qps_per_worker: 25.0
          burst: 25
          max_pending: 50
        cloudflare_public_dns:
          qps_per_worker: 25.0
          burst: 25
          max_pending: 50
        opendns_public_dns:
          qps_per_worker: 25.0
          burst: 25
          max_pending: 50
        custom:
          qps_per_worker: 25.0
          burst: 25
          max_pending: 50
    # Deterministic endpoint selection across the configured resolver pool.
    # Retry attempts select through the same round-robin balancer so one
    # transient resolver failure does not pin all attempts to the same endpoint.
    query_balancer:
      enabled: true
      strategy: round_robin
    # Mandatory NS lookup for the parsed registrable domain. Stage-level
    # nameservers/timeout/ecs/query_rate_limit/query_balancer override the
    # top-level DNS resolver profile when present. This lets delegation use a
    # non-ECS resolver profile while host resolution keeps ECS-capable resolvers.
    # Timeout/SERVFAIL are retried up to this stage-specific attempt count and
    # are not cached after retry exhaustion.
    delegation:
      # Example non-ECS delegation pool:
      # nameservers:
      #   - system_resolver
      #   - 1.1.1.1
      #   - 1.0.0.1
      #   - 208.67.222.222
      #   - 208.67.220.220
      # ecs:
      #   enabled: false
      #   subnet: ""
      #   scope_prefix_length: 0
      retry_attempts: 3
    # Optional exact-host A/AAAA/CNAME resolution. It has a separate DNS
    # coordinator from delegation and inherits the top-level DNS resolver profile
    # unless stage-level resolver fields are provided. If enabled is omitted,
    # the runtime defaults it to true when geo.enabled=true and false otherwise.
    # Timeout/SERVFAIL use this stage-specific retry budget and are not cached
    # after retry exhaustion.
    host_resolution:
      enabled: false
      retry_attempts: 3

  geo:
    # Enable geo lookups and evaluate the resolved IPs against the policy block
    # below. Geo only runs after delegation passes and host_resolution passes
    # when host_resolution is enabled.
    enabled: false
    # Compatibility/readability field. Runtime provider selection is inferred
    # from the policy below:
    # - no region rules -> ipinfo_lite
    # - any region rules -> geojs
    provider: ipinfo_lite
    # Per-request timeout, in seconds, for geo lookups.
    timeout: 5.0
    # Number of days to keep successful usable geo results cached. Provider
    # failures, invalid payloads, rate limits, exceptions, and non-usable
    # results are not cached.
    cache_ttl_days: 7
    # In GitHub Actions, pass GEO_IPINFO_TOKEN through step-level env for
    # country-only ipinfo_lite lookups. Runtime consumes that env token without
    # writing it into prepared worker bundles; leave geo.token blank unless you
    # intentionally commit an explicit config token.
    policy:
      enabled: false
      match_scope: all_ips
      include:
        countries: []
        # Region examples: California, Ontario.
        regions: []
      exclude:
        countries: []
        # Region examples: California, Ontario.
        regions: []

  output:
    # Output directory for files written by the pipeline.
    # For a config named config/domain-pipeline.yaml, the runtime writes:
    # - output/filtered/domain-pipeline.txt
    # - output/unactionable/domain-pipeline.txt
    # - output/review/domain-pipeline.csv
    directory: output

cache:
  classification_ttl_days:
    # Cache retention, in days, for delegated registrable domains.
    dns_delegation_actionable: 7
    # Cache retention, in days, for registrable domains without usable NS
    # delegation. Transient timeout/SERVFAIL delegation results are not cached.
    dns_delegation_unactionable: 1
  # Cache retention, in days, for stable exact-host dns.host_resolution results.
  # This legacy scalar remains the fallback for resolved host-resolution rows.
  dns_ttl_days: 1
  # Cache retention, in days, by final exact-host dns.host_resolution outcome.
  # CNAME aliases are followed before the final outcome is chosen. Transient
  # timeout/SERVFAIL and inconsistent unknown host-resolution results are not
  # cached after retry exhaustion.
  dns_host_resolution_ttl_days:
    resolved: 1
    nodata: 1
    nxdomain: 1
    unknown: 0

sources:
  - id: local-default
    enabled: true
    input:
      # Valid values: file, url
      type: file
      # For file inputs, glob patterns such as input/*.txt are expanded.
      location: input/test.txt
      # Valid values: auto, plain, hosts, adblock, dnsmasq
      format: auto
    fetch:
      request_timeout: 30.0
    dns:
      nameservers: []
      timeout: 5.0
      ecs:
        enabled: false
        subnet: ""
        scope_prefix_length: 0
      query_rate_limit:
        enabled: true
      query_balancer:
        enabled: true
        strategy: round_robin
      delegation:
        retry_attempts: 3
      host_resolution:
        enabled: false
        retry_attempts: 3
    geo:
      enabled: false
      provider: ipinfo_lite
      timeout: 5.0
      cache_ttl_days: 7
      policy:
        enabled: false
        match_scope: all_ips
        include:
          countries: []
          regions: []
        exclude:
          countries: []
          regions: []
    output:
      directory: output
