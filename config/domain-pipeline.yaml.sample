version: 2

# Defaults inherited by every source unless a source overrides them.
# One workflow owns one config file. A config file may still contain multiple
# sources, but emitted artifacts are grouped by the config filename instead of
# by each source id.
#
# Optional manual filter files:
# - input/manual_filter_pass/<config-stem>.txt
# - input/manual_filter_out/<config-stem>.txt
# - input/manual_add/<config-stem>.txt
# manual_filter_pass and manual_add entries require an actionable delegation
# result for the registrable domain. Source-matched public suffix
# manual_filter_pass entries route to filtered during prepare because there is
# no registrable domain to query. Delegation is actionable when NS records
# exist, NS returns NODATA, NS returns NXDOMAIN with same-owner SOA, or the NS
# retry budget is exhausted with same-owner SOA. NS NODATA does not require SOA
# fallback. If delegation is actionable,
# manual_filter_pass and manual_add skip host-resolution and IP-location and
# route to filtered. manual_add takes precedence over matching source entries
# for the same host. If delegation is not actionable, they route to
# unactionable or review using the normal delegation result. Unmatched
# manual_add entries require all enabled sources to share dns_query,
# delegation, and output behavior. Unmatched manual_filter_pass entries route
# to review without delegation or host-resolution lookup because they are
# operator reconciliation rows. manual_filter_out is exact-host-only, takes
# precedence over matching source entries, bypasses delegation, host resolution,
# and IP-location entirely, and routes to review. Other public suffix inputs are
# prepare-owned terminal rows because there is no registrable domain to query.
#
# Runtime rows use three terminal routes:
# - filtered: positive output rows.
# - review: uncertain or operator-attention rows.
# - unactionable: rows whose registrable domain has no actionable delegation.
# Duplicate host collapse is keyed by final host and compares dns_query,
# delegation, host_resolution, ip_location, and output behavior across enabled
# sources. For manual_add-matched hosts, only dns_query/delegation/output
# behavior must match because manual_add bypasses host-resolution and
# IP-location after delegation passes.
defaults:
  fetch:
    # Network timeout, in seconds, for retrieving source content before the
    # pipeline gives up on the fetch step.
    request_timeout: 30.0

  dns_query:
    # Fallback resolver pool used by DNS stages that do not set their own
    # resolvers. Entries use resolver: <IPv4/IPv6/system_resolver>. Omit
    # weight on every entry for equal traffic share, or set weight on every
    # entry for explicit weighted traffic share. Mixed weighted/unweighted
    # resolver lists are invalid. Leave empty to use only the platform resolver
    # for stages that inherit this fallback.
    default_resolvers: []
    # Per-query DNS timeout, in seconds.
    timeout: 25.0
    # Base wait, in seconds, for exponential DNS retry backoff after retryable
    # timeout/SERVFAIL outcomes. Runtime caps each retry wait at 2 seconds.
    retry_backoff_base_seconds: 1.0
    # DNS safety limits. qps_per_worker is a worker-local project cap for one
    # provider bucket, not a provider-published guarantee.
    query_rate_limit:
      enabled: true
      providers:
        system_resolver:
          qps_per_worker: 60.0
          burst: 10
          max_pending: 32
        google_public_dns:
          qps_per_worker: 30.0
          burst: 5
          max_pending: 16
        quad9_ecs_public_dns:
          qps_per_worker: 30.0
          burst: 5
          max_pending: 16
        cloudflare_public_dns:
          qps_per_worker: 12.0
          burst: 2
          max_pending: 8
        opendns_public_dns:
          qps_per_worker: 12.0
          burst: 2
          max_pending: 8
        controld_unfiltered_public_dns:
          qps_per_worker: 12.0
          burst: 2
          max_pending: 8
        dns_sb_public_dns:
          qps_per_worker: 12.0
          burst: 2
          max_pending: 8
        unrecognized_resolver:
          qps_per_worker: 12.0
          burst: 2
          max_pending: 8
    # Mandatory delegation authority check for the parsed registrable domain.
    # The check starts with an NS query. SOA fallback is used after NS NXDOMAIN
    # or NS retry exhaustion, and is not used for NS NODATA. The original NS
    # negative response is reused only when its authority section contains
    # same-owner SOA; otherwise the runtime creates a separate SOA query because
    # the original NS response may not prove the queried registrable domain's
    # SOA ownership. The terminal delegation result is cached as one
    # domain-plus-resolver-profile row, not as separate NS and SOA cache rows.
    # Delegation does not use ECS.
    # Stage-level resolvers/timeout/query_rate_limit override the top-level
    # DNS defaults when present. Retryable NS timeout/SERVFAIL outcomes share
    # the NS retry-exhausted delegation status family after this
    # stage-specific attempt count. Review delegation outcomes are not cached.
  delegation:
    # Example non-ECS delegation pool:
    # resolvers:
    #   - resolver: system_resolver
    #   - resolver: 1.1.1.1
    #   - resolver: 1.0.0.1
    #   - resolver: 76.76.2.0
    #   - resolver: 76.76.10.0
    #   - resolver: 185.222.222.222
    #   - resolver: 45.11.45.11
    # Example weighted delegation pool:
    # resolvers:
    #   - resolver: system_resolver
    #     weight: 2
    #   - resolver: 1.1.1.1
    #     weight: 1
    retry_attempts: 4
    # Optional exact-host A/AAAA/CNAME resolution. It has a separate DNS
    # coordinator from delegation. It inherits dns_query.default_resolvers unless
    # resolvers is provided here. Host-resolution resolver entries accept the
    # same all-or-none weight field as delegation: omit weight on every entry
    # for equal first-attempt share, or set weight on every entry for explicit
    # stage-local traffic preference. ECS applies only to host resolution; when
    # enabled, use resolvers that preserve ECS behavior, such as Google Public
    # DNS (8.8.8.8, 8.8.4.4) and Quad9 ECS (9.9.9.11, 149.112.112.11).
    # Cloudflare 1.1.1.1 and Cisco Umbrella are not default ECS targets here
    # because their public ECS behavior differs. If enabled is omitted, the
    # runtime defaults it to true when ip_location.enabled=true and false otherwise.
    # Timeout/SERVFAIL use this stage-specific retry budget and are not cached
    # after retry exhaustion.
  host_resolution:
    enabled: false
    # resolvers:
    #   - resolver: 8.8.8.8
    #     weight: 2
    #   - resolver: 8.8.4.4
    #     weight: 1
    # Optional EDNS Client Subnet (ECS) settings. Set enabled=true and provide
    # a CIDR subnet when querying a resolver that accepts client-supplied ECS.
    ecs:
      enabled: false
      # Example: 203.0.113.0/24 or 2001:db8::/48
      subnet: ""
      # Scope to advertise in the ECS option. Leave at 0 unless you have a
      # specific resolver-side requirement.
      scope_prefix_length: 0
    retry_attempts: 3

  ip_location:
    # Enable IP-location lookups and evaluate the resolved IPs against the policy block
    # below. IP-location only runs after delegation passes and host_resolution passes
    # when host_resolution is enabled.
    enabled: false
    # Runtime provider selection is inferred from the policy below:
    # - no region rules -> ipinfo_lite
    # - any region rules -> geojs
    # Per-request timeout, in seconds, for IP-location lookups.
    timeout: 5.0
    # Number of days to keep successful usable IP-location results cached. Provider
    # failures, invalid payloads, rate limits, exceptions, and non-usable
    # results are not cached.
    cache_ttl_days: 7
    # GitHub Actions secret storage name: IPINFO_API_TOKEN. The reusable workflow
    # passes it to Python as runtime env IP_LOCATION_IPINFO_TOKEN for country-only
    # ipinfo_lite lookups. Runtime consumes that env token without writing it into
    # prepare-to-worker manifests; leave ip_location.token blank unless you
    # intentionally commit an explicit config token. Prepare-batch exits before
    # worker manifests are created when ipinfo_lite is enabled without a token.
    # When a token exists, prepare-batch sends one non-retried IPinfo validation
    # probe and fails only when IPinfo proves credential rejection with HTTP 401
    # or 403. Rate limits, network failures, and inconclusive validation payloads
    # do not fail prepare; worker lookup logic handles later provider availability
    # and data-quality outcomes.
    policy:
      enabled: false
      match_scope: all_ips
      include:
        countries: []
        # Region examples: California, Ontario.
        regions: []
      exclude:
        countries: []
        # Region examples: California, Ontario.
        regions: []

  output:
    # Output directory for final aggregate publish files.
    # For a config named config/domain-pipeline.yaml, aggregation writes:
    # - output/filtered/domain-pipeline.txt
    # - output/unactionable/domain-pipeline.txt
    # - output/review/domain-pipeline.csv when review rows exist
    directory: output

runtime:
  # Worker-local async concurrency for each processing stage inside one GitHub
  # matrix worker. Delegation consumes registrable-domain root work and fans
  # results out to host rows; host_resolution and IP-location stay host-level.
  # Delegation and enabled host_resolution stages can adapt between minimums
  # and caps. Scale-up requires backlog, sustained DNS/in-flight work, and
  # usable provider capacity; one pressured provider does not by itself block
  # the whole stage, but all-provider pressure blocks creation. Disabled
  # host_resolution starts no host_resolution consumers. IP-location uses
  # static worker-local consumers.
  # GitHub matrix concurrency is controlled separately by workflow settings.
  stage_concurrency:
    minimums:
      delegation: 20
      host_resolution: 20
      ip_location: 8
    adaptive:
      enabled: true
      delegation_enabled: true
      host_resolution_enabled: true
      supervisor_interval_seconds: 1.0
      busy_scale_up_after_seconds: 5.0
      idle_scale_down_after_seconds: 5.0
      pressure_window_seconds: 5.0
      queue_pressure_ratio: 0.8
      max_concurrency_multiplier: 4
      scale_up_step: 1
      scale_down_step: 1

cache:
  delegation_ttl_days:
    # Cache retention, in days, for actionable registrable domains: NS records
    # exist, NS NODATA, NS NXDOMAIN with same-owner SOA, or NS retry-exhausted
    # with same-owner SOA.
    actionable: 7
    # Cache retention, in days, for stable unactionable delegation: NS NXDOMAIN
    # with SOA absent, or successful NS answers with no nameserver targets.
    # Review delegation outcomes are not cached.
    unactionable: 1
  # Cache retention, in days, for stable exact-host host_resolution results.
  # CNAME aliases are followed before the final outcome is chosen. Transient
  # timeout/SERVFAIL host-resolution results are not cached after retry exhaustion.
  host_resolution_ttl_days:
    resolved: 1
    nodata: 1
    nxdomain: 1

sources:
  - id: local-default
    enabled: true
    input:
      # Valid values: file, url
      type: file
      # For file inputs, provide one concrete file path. The source reader opens
      # input.location directly and does not expand glob patterns.
      location: input/test.txt
      # Valid explicit values: auto, plain, hosts, adblock, dnsmasq.
      # With auto, prepare also detects supported Surge RULE-SET domain
      # declarations and Surge DOMAIN-SET lists. Surge formats are not valid
      # explicit input.format values.
      format: auto
    fetch:
      request_timeout: 30.0
    dns_query:
      default_resolvers: []
      timeout: 25.0
      retry_backoff_base_seconds: 1.0
      query_rate_limit:
        enabled: true
    delegation:
      retry_attempts: 4
    host_resolution:
      enabled: false
      ecs:
        enabled: false
        subnet: ""
        scope_prefix_length: 0
      retry_attempts: 3
    ip_location:
      enabled: false
      timeout: 5.0
      cache_ttl_days: 7
      policy:
        enabled: false
        match_scope: all_ips
        include:
          countries: []
          regions: []
        exclude:
          countries: []
          regions: []
    output:
      directory: output
