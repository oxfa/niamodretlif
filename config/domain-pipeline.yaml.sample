version: 2

# Defaults are inherited independently by every source unless that source
# overrides them. For example, in one config with sources A, B, C, and D, A and
# B can specify their own settings while C and D omit those settings and use
# defaults. A source override affects only that source; it does not change the
# defaults inherited by other sources.
# Overrides merge recursively for mappings: omitted nested keys keep their
# inherited values, while explicitly supplied scalar or list values replace
# the inherited value. Each source must still provide its own input.
# The root-level output section applies once to the results of all sources in
# this config; outputs are not source-specific.
# One workflow owns one config file. A config file may still contain multiple
# sources, but emitted artifacts are grouped by the config filename instead of
# by each source id.
#
# Optional operator input files are named <config-stem>.txt inside each
# configurable category directory below.
# Registrable manually_selected_for_filtered and manually_added entries use the
# shared registrable-domain DNS result. A root review or unactionable outcome
# takes precedence; an actionable root lets these manual routes bypass host
# resolution and IP location. An unmatched selected entry remains a
# prepare-owned review row. A PSL-valid source target or manual addition with no
# registrable domain has no worker route and remains eligible for
# format-specific filtered output. An unmatched manually_added registrable
# domain requires all enabled sources to share its root DNS behavior.
# manually_excluded_from_sources is target-based source subtraction: source
# entries whose parsed normalized target matches an operator entry are removed
# before worker assignments and valid source-item mappings; non-matches are
# silent no-ops. Excluded targets cannot re-enter through a manual route.
#
# Worker results contain one registrable-domain DNS outcome and one final route
# per input domain. Root review or unactionable outcomes fan out to the root's
# input domains. For an actionable root, ordinary domains use their effective
# host-resolution and IP-location settings; disabled host resolution routes to
# filtered, while manual additions/selections bypass both stages. Duplicate
# input domains are assigned once after route-relevant profiles are checked:
# root DNS settings must agree under a root, while host/IP settings need agree
# only for repeated ordinary domains that reach those stages. Source identity
# and source membership stay in aggregate source-item mappings and are not sent
# to workers or published in the merged review output.
manual_inputs:
  manually_selected_for_filtered: manual_inputs/manually_selected_for_filtered
  manually_excluded_from_sources: manual_inputs/manually_excluded_from_sources
  manually_added: manual_inputs/manually_added

output:
  # All publish output paths are configured explicitly and relative to the
  # repository root.
  filtered:
    - path: output/filtered/domain-pipeline.txt
      format: plain
    # Each file renders eligible source targets and manually added domains,
    # deduplicated according to that file's configured format. AdBlock outputs
    # also preserve valid no-target rules and recognized metadata.
    # - path: output/filtered/domain-pipeline-adblock.txt
    #   format: adblock
  review: output/review/domain-pipeline.csv
  unactionable: output/unactionable/domain-pipeline.txt

defaults:
  fetch:
    # Network timeout, in seconds, for retrieving source content before the
    # pipeline gives up on the fetch step.
    request_timeout: 30.0

  dns_query:
    # Fallback resolver pool used by DNS stages that do not set their own
    # resolvers. Entries use resolver: <IPv4/IPv6/system_resolver>. Omit
    # weight on every entry for equal traffic share, or set weight on every
    # entry for explicit weighted traffic share. Mixed weighted/unweighted
    # resolver lists are invalid. Leave empty to use only the platform resolver
    # for stages that inherit this fallback.
    default_resolvers: []
    # Per-query DNS timeout, in seconds.
    timeout: 25.0
    # Base wait, in seconds, for exponential DNS retry backoff after retryable
    # timeout/SERVFAIL outcomes. Runtime caps each retry wait at 2 seconds.
    retry_backoff_base_seconds: 1.0
    # DNS safety limits. qps_per_worker is a worker-local project cap for one
    # provider bucket, not a provider-published guarantee.
    query_rate_limit:
      enabled: true
      providers:
        system_resolver:
          qps_per_worker: 60.0
          burst: 10
          max_pending: 32
        google_public_dns:
          qps_per_worker: 30.0
          burst: 5
          max_pending: 16
        quad9_ecs_public_dns:
          qps_per_worker: 30.0
          burst: 5
          max_pending: 16
        cloudflare_public_dns:
          qps_per_worker: 12.0
          burst: 2
          max_pending: 8
        opendns_public_dns:
          qps_per_worker: 12.0
          burst: 2
          max_pending: 8
        controld_unfiltered_public_dns:
          qps_per_worker: 12.0
          burst: 2
          max_pending: 8
        dns_sb_public_dns:
          qps_per_worker: 12.0
          burst: 2
          max_pending: 8
        unrecognized_resolver:
          qps_per_worker: 12.0
          burst: 2
          max_pending: 8
    # Mandatory delegation authority check for the parsed registrable domain.
    # The check starts with an NS query. SOA fallback is used after NS NXDOMAIN
    # or NS retry exhaustion, and is not used for NS NODATA. The original NS
    # negative response is reused only when its authority section contains
    # same-owner SOA; otherwise the runtime creates a separate SOA query because
    # the original NS response may not prove the queried registrable domain's
    # SOA ownership. The terminal delegation result is cached as one
    # domain-plus-resolver-profile row, not as separate NS and SOA cache rows.
    # Delegation does not use ECS.
    # Stage-level resolvers/timeout/query_rate_limit override the top-level
    # DNS defaults when present. Retryable NS timeout/SERVFAIL outcomes share
    # the NS retry-exhausted delegation status family after this
    # stage-specific attempt count. Review delegation outcomes are not cached.
  delegation:
    # Example non-ECS delegation pool:
    # resolvers:
    #   - resolver: system_resolver
    #   - resolver: 1.1.1.1
    #   - resolver: 1.0.0.1
    #   - resolver: 76.76.2.0
    #   - resolver: 76.76.10.0
    #   - resolver: 185.222.222.222
    #   - resolver: 45.11.45.11
    # Example weighted delegation pool:
    # resolvers:
    #   - resolver: system_resolver
    #     weight: 2
    #   - resolver: 1.1.1.1
    #     weight: 1
    retry_attempts: 4
    # Optional input-domain A/AAAA/CNAME resolution. It has a separate DNS
    # coordinator from delegation. It inherits dns_query.default_resolvers
    # unless resolvers is provided here. Host-resolution resolver entries accept the
    # same all-or-none weight field as delegation: omit weight on every entry
    # for equal first-attempt share, or set weight on every entry for explicit
    # stage-local traffic preference. ECS applies only to host resolution; when
    # enabled, use resolvers that preserve ECS behavior, such as Google Public
    # DNS (8.8.8.8, 8.8.4.4) and Quad9 ECS (9.9.9.11, 149.112.112.11).
    # Cloudflare 1.1.1.1 and Cisco Umbrella are not default ECS targets here
    # because their public ECS behavior differs. If enabled is omitted, the
    # runtime defaults it to true when ip_location.enabled=true and false otherwise.
    # Timeout/SERVFAIL use this stage-specific retry budget and are not cached
    # after retry exhaustion. Resolve the input domain itself. When it equals
    # its registrable root, also resolve www.<root> if
    # resolve_www_for_registrable_domain is true; a specific subdomain input
    # resolves only itself.
  host_resolution:
    enabled: false
    resolve_www_for_registrable_domain: true
    # resolvers:
    #   - resolver: 8.8.8.8
    #     weight: 2
    #   - resolver: 8.8.4.4
    #     weight: 1
    # Optional EDNS Client Subnet (ECS) settings. Set enabled=true and provide
    # a CIDR subnet when querying a resolver that accepts client-supplied ECS.
    ecs:
      enabled: false
      # Example: 203.0.113.0/24 or 2001:db8::/48
      subnet: ""
      # Scope to advertise in the ECS option. Leave at 0 unless you have a
      # specific resolver-side requirement.
      scope_prefix_length: 0
    retry_attempts: 3

  ip_location:
    # Enable IP-location lookups and evaluate the resolved IPs against the policy block
    # below. IP-location only runs after delegation passes and host_resolution passes
    # when host_resolution is enabled.
    enabled: false
    # Runtime provider selection is inferred from the policy below:
    # - no region rules -> ipinfo_lite
    # - any region rules -> geojs
    # Per-request timeout, in seconds, for IP-location lookups.
    timeout: 5.0
    # Number of days to keep successful usable IP-location results cached. Provider
    # failures, invalid payloads, rate limits, exceptions, and non-usable
    # results are not cached.
    cache_ttl_days: 7
    # GitHub Actions secret storage name: IPINFO_API_TOKEN. The reusable workflow
    # passes it to Python as runtime env IP_LOCATION_IPINFO_TOKEN for country-only
    # ipinfo_lite lookups. Runtime consumes that env token without writing it into
    # prepare-to-worker manifests. Credentials are not accepted in config.
    # Prepare-batch exits before worker manifests are created when ipinfo_lite is
    # enabled without a token.
    # When a token exists, prepare-batch sends one non-retried IPinfo validation
    # probe and fails only when IPinfo proves credential rejection with HTTP 401
    # or 403. Rate limits, network failures, and validation payloads that do not
    # prove credential validity do not fail prepare; worker lookup logic handles
    # later provider availability and data-quality outcomes.
    policy:
      enabled: false
      match_scope: all_ips
      include:
        countries: []
        # Region examples: California, Ontario.
        regions: []
      exclude:
        countries: []
        # Region examples: California, Ontario.
        regions: []

runtime:
  # Worker-local async concurrency for each processing stage inside one GitHub
  # matrix worker. Delegation consumes registrable-domain root work and fans
  # results out to input-domain rows; host_resolution and IP-location operate
  # on each original input domain.
  # Delegation and enabled host_resolution stages can adapt between minimums
  # and caps. Scale-up requires backlog, sustained DNS/in-flight work, and
  # usable provider capacity; one pressured provider does not by itself block
  # the whole stage, but all-provider pressure blocks creation. Disabled
  # host_resolution starts no host_resolution consumers. IP-location uses
  # static worker-local consumers.
  # GitHub matrix concurrency is controlled separately by workflow settings.
  stage_concurrency:
    minimums:
      delegation: 20
      host_resolution: 20
      ip_location: 8
    adaptive:
      enabled: true
      delegation_enabled: true
      host_resolution_enabled: true
      supervisor_interval_seconds: 1.0
      busy_scale_up_after_seconds: 5.0
      idle_scale_down_after_seconds: 5.0
      pressure_window_seconds: 5.0
      queue_pressure_ratio: 0.8
      max_concurrency_multiplier: 4
      scale_up_step: 1
      scale_down_step: 1

cache:
  delegation_ttl_days:
    # Cache retention, in days, for actionable registrable domains: NS records
    # exist, NS NODATA, NS NXDOMAIN with same-owner SOA, or NS retry-exhausted
    # with same-owner SOA.
    actionable: 7
    # Cache retention, in days, for stable unactionable delegation: NS NXDOMAIN
    # with SOA absent, or successful NS answers with no nameserver targets.
    # Review delegation outcomes are not cached.
    unactionable: 1
  # Cache retention, in days, for stable exact-host host_resolution results.
  # CNAME aliases are followed before the final outcome is chosen. Transient
  # timeout/SERVFAIL host-resolution results are not cached after retry exhaustion.
  host_resolution_ttl_days:
    resolved: 1
    nodata: 1
    nxdomain: 1

sources:
  # Every item is an independent source. Its optional fetch, DNS, delegation,
  # host-resolution, and IP-location sections override only that source's
  # inherited defaults.
  - id: local-default
    enabled: true
    input:
      # Valid values: file, url
      type: file
      # For file inputs, provide one concrete file path. The source reader opens
      # input.location directly and does not expand glob patterns.
      location: manual_inputs/test.txt
      # Valid explicit values: auto, plain, hosts, adblock, dnsmasq.
      # With auto, prepare also detects supported Surge RULE-SET domain
      # declarations and Surge DOMAIN-SET lists. Surge formats are not valid
      # explicit input.format values.
      format: auto
    fetch:
      request_timeout: 30.0
    dns_query:
      default_resolvers: []
      timeout: 25.0
      retry_backoff_base_seconds: 1.0
      query_rate_limit:
        enabled: true
    delegation:
      retry_attempts: 4
    host_resolution:
      enabled: false
      resolve_www_for_registrable_domain: true
      ecs:
        enabled: false
        subnet: ""
        scope_prefix_length: 0
      retry_attempts: 3
    ip_location:
      enabled: false
      timeout: 5.0
      cache_ttl_days: 7
      policy:
        enabled: false
        match_scope: all_ips
        include:
          countries: []
          regions: []
        exclude:
          countries: []
          regions: []
